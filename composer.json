{
  "name": "twint-ag/twint-magento-hyva-integration",
  "version": "9.9.9-dev",
  "description": "This module enables the use of Twint with Hyvä Theme and optionally Hyvä Checkout",
  "homepage": "https://twint.ch",
  "type": "magento2-module",
  "license": [
    "MIT"
  ],
  "authors": [
    {
      "name": "TWINT",
      "email": "plugin@twint.ch",
      "homepage": "https://twint.ch",
      "role": "Maintainer"
    }
  ],
  "keywords": [
    "twint",
    "twint.ch",
    "switzerland",
    "checkout",
    "express checkout",
    "payment",
    "magento",
    "magento2",
    "hyva",
    "hyva-checkout",
    "hyva-themes"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "magewirephp/magewire": "^1.0 || ^2.0 || ^3.0",
    "magento/framework": ">=103.0.4",
    "magento/module-sales": ">=103.0.4",
    "magento/module-csp": "*",
    "twint-ag/twint-magento-extension": "^1.2.6"
  },
  "require-dev": {
    "symplify/easy-coding-standard": "^12.1",
    "slevomat/coding-standard": "^8.15",
    "rector/rector": "^1.2",
    "phpspec/prophecy-phpunit": "^2.2",
    "phpunit/phpunit": "^10.5",
    "mockery/mockery": "^1.6",
    "squizlabs/php_codesniffer": "^3.0"
  },
  "suggest": {
    "hyva-themes/magento2-theme-module": "^1.3 - Required at runtime. Install it from the Hyvä repository covered by your Hyvä licence.",
    "hyva-themes/magento2-hyva-checkout": "^1.3 - Required for TWINT regular checkout inside Hyvä Checkout. Express checkout works without it."
  },
  "repositories": {
    "0": {
      "type": "composer",
      "url": "https://repo.magento.com/"
    }
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Twint\\MagentoHyva\\": ""
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "magento/composer-dependency-version-audit-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "magento/magento-composer-installer": true
    }
  }
}
